@page "/resume"
@model OrchardCoreContrib.Themes.Personal.Pages.ResumeModel
@{
}

<!-- Page Content-->
<div class="container px-5 my-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bolder mb-0"><span class="text-gradient d-inline">@T["Resume"]</span></h1>
    </div>
    <div class="row gx-5 justify-content-center">
        <div class="col-lg-11 col-xl-9 col-xxl-8">
            <!-- Experience Section-->
            <section>
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h2 class="text-primary fw-bolder mb-0">@T["Experience"]</h2>
                    <!-- Download resume button-->
                    <!-- Note: Set the link href target to a PDF file within your project-->
                    <a class="btn btn-primary px-4 py-3" href="#!">
                        <div class="d-inline-block bi bi-download me-2"></div>
                        @T["Download Resume"]
                    </a>
                </div>
                <!-- Experience Card 1-->
                @foreach (var experienceContentItem in Model.ExperienceContentItems)
                {
                    <div class="card shadow border-0 rounded-4 mb-5">
                        <div class="card-body p-5">
                            <div class="row align-items-center gx-5">
                                <div class="col text-center text-lg-start mb-4 mb-lg-0">
                                    <div class="bg-light p-4 rounded-4">
                                        <div class="text-primary fw-bolder mb-2">@experienceContentItem.Content.Experience.StartYear.Value - @(experienceContentItem.Content.Experience.EndYear.Value ?? "Present")</div>
                                        <div class="small fw-bolder">@experienceContentItem.Content.Experience.JobTitle.Text</div>
                                        <div class="small text-muted">@experienceContentItem.Content.Experience.Company.Text</div>
                                        <div class="small text-muted">@experienceContentItem.Content.Experience.Location.Text</div>
                                    </div>
                                </div>
                                <div class="col-lg-8"><div>@experienceContentItem.Content.Experience.Biography.Text</div></div>
                            </div>
                        </div>
                    </div>
                }
            </section>
            <!-- Education Section-->
            <section>
                <h2 class="text-secondary fw-bolder mb-4">@T["Education"]</h2>
                @foreach (var educationContentItem in Model.EducationContentItems)
                {
                    <!-- Education Card 1-->
                    <div class="card shadow border-0 rounded-4 mb-5">
                        <div class="card-body p-5">
                            <div class="row align-items-center gx-5">
                                <div class="col text-center text-lg-start mb-4 mb-lg-0">
                                    <div class="bg-light p-4 rounded-4">
                                        <div class="text-secondary fw-bolder mb-2">@educationContentItem.Content.Education.StartYear.Value - @(educationContentItem.Content.Education.EndYear.Value)</div>
                                        <div class="mb-2">
                                            <div class="small fw-bolder">@educationContentItem.Content.Education.University.Text</div>
                                            <div class="small text-muted">@educationContentItem.Content.Education.Location.Text</div>
                                        </div>
                                        <div class="fst-italic">
                                            <div class="small text-muted">@educationContentItem.Content.Education.Major.Text</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-8"><div>@educationContentItem.Content.Education.Biography.Text</div></div>
                            </div>
                        </div>
                    </div>
                }
            </section>
            <!-- Divider-->
            <div class="pb-5"></div>
            <!-- Skills Section-->
            <section>
                <!-- Skillset Card-->
                <div class="card shadow border-0 rounded-4 mb-5">
                    <div class="card-body p-5">
                        <!-- Professional skills list-->
                        <div class="mb-5">
                            <div class="d-flex align-items-center mb-4">
                                <div class="feature bg-primary bg-gradient-primary-to-secondary text-white rounded-3 me-3"><i class="bi bi-tools"></i></div>
                                <h3 class="fw-bolder mb-0"><span class="text-gradient d-inline">@T["Professional Skills"]</span></h3>
                            </div>
                            @for (var i = 0; i < Model.SkillContentItems.Count(); i += 3)
                            {
                                <div class="row row-cols-1 row-cols-md-3 mb-4">
                                    @foreach (var skillContentItem in Model.SkillContentItems.Skip(i).Take(3))
                                    {
                                        <div class="col mb-4 mb-md-0"><div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">@skillContentItem.DisplayText</div></div>
                                    }
                                </div>
                            }
                        </div>
                        <!-- Languages list-->
                        <div class="mb-0">
                            <div class="d-flex align-items-center mb-4">
                                <div class="feature bg-primary bg-gradient-primary-to-secondary text-white rounded-3 me-3"><i class="bi bi-code-slash"></i></div>
                                <h3 class="fw-bolder mb-0"><span class="text-gradient d-inline">@T["Languages"]</span></h3>
                            </div>
                            @for (var i = 0; i < Model.LanguageContentItems.Count(); i += 3)
                            {
                                <div class="row row-cols-1 row-cols-md-3 mb-4">
                                    @foreach (var languageContentItem in Model.LanguageContentItems.Skip(i).Take(3))
                                    {
                                        <div class="col mb-4 mb-md-0"><div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">@languageContentItem.DisplayText</div></div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>