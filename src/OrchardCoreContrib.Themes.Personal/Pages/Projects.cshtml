@page "/projects"
@model OrchardCoreContrib.Themes.Personal.Pages.ProjectsModel

<!-- Projects Section-->
<section class="py-5">
    <div class="container px-5 mb-5">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bolder mb-0"><span class="text-gradient d-inline">@T["Projects"]</span></h1>
        </div>
        <div class="row gx-5 justify-content-center">
            <div class="col-lg-11 col-xl-9 col-xxl-8">
                @foreach (var projectContentItem in Model.ProjectContentItems)
                {
                    <div class="card overflow-hidden shadow rounded-4 border-0 mb-5">
                        <div class="card-body p-0">
                            <div class="d-flex align-items-center">
                                <div class="p-5">
                                    <h2 class="fw-bolder">@projectContentItem.DisplayText</h2>
                                    @Html.Raw(projectContentItem.Content.HtmlBodyPart.Html)
                                </div>
                                <img class="img-fluid" src="@Orchard.AssetUrl((string)projectContentItem.Content.Project.Picture.Paths[0])" alt="..." />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
<!-- Call to action section-->
<section class="py-5 bg-gradient-primary-to-secondary text-white">
    <div class="container px-5 my-5">
        <div class="text-center">
            <h2 class="display-4 fw-bolder mb-4">@T["Let's build something together"]</h2>
            <a class="btn btn-outline-light btn-lg px-5 py-3 fs-6 fw-bolder" href="contact.html">@T["Contact me"]</a>
        </div>
    </div>
</section>
